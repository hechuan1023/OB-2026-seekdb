.gitattributes export-ignore
.gitignore export-ignore

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat

# Preserve verified source/report bytes across Windows and Linux checkouts.
/minivectordb/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tests/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/native/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol -filter
/docs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/agent/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/Dockerfile -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/build-dependencies.lock -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/pyproject.toml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Tool transcripts retain original terminal whitespace.
/docs/*.txt -whitespace
