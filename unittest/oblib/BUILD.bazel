load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_testonly = True)

# The third party header repository only ships libgtest, so the test carries
# its own entry point and links oblib through the test only runtime.
cc_test(
    name = "test_hnsw_serial_format",
    srcs = ["test_hnsw_serial_format.cpp"],
    linkstatic = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//src/oblib:oblib_test_runtime",
        "@seekdb_3rd_headers//:gtest",
    ],
)
